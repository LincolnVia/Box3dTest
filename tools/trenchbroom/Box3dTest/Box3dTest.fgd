@SolidClass = worldspawn : "Box3dTest world"
[
    message(string) : "Level name"
]

@PointClass size(-16 -16 -24, 16 16 32) color(0 255 0) = info_player_start : "Player start"
[
    angle(integer) : "Direction" : 0
]

@PointClass size(-16 -16 -24, 16 16 32) color(0 200 0) = info_player_deathmatch : "Alternate player start"
[
    angle(integer) : "Direction" : 0
]

@PointClass size(-8 -8 -8, 8 8 8) color(255 255 100) = triggerd_light : "Triggered Point light"
[
    light(integer) : "Brightness" : 300
    _color(color255) : "Color" : "255 255 255"
    listenOn(integer) : "Listen On" : -1
    triggered(integer) : "Triggered" : 0
]
@PointClass size(-8 -8 -8, 8 8 8) color(255 255 100) = light : "Point light"
[
    light(integer) : "Brightness" : 300
    _color(color255) : "Color" : "255 255 255"
]

@SolidClass color(255 255 100) = info_trigger : "Trigger"
[
    target(integer) : "target" : -1
    triggered(integer) : "Triggered" : 0
    enabled(integer) : "Enabled" : 1
]

@PointClass size(-8 -8 -8, 8 8 8) color(255 0 0) model({"path": "resources/models/heavy_zombie.glb", "scale": 60, "angle": -1}) = info_zombie_spawn : "Enemy spawner"
[ 
    angles(string) : "Angles (P Y R)" : "-90 0 0"
    spawnrate(integer) : "Spawn Rate" : 0
    limit(integer) : "Max Spawns" : 1 
    enabled(integer) : "Enabled" : 1
]
@PointClass size(-16 -16 -16, 16 16 16) color(100 180 255) model({ "path": "resources/models/" + model, "scale": scale * 20 }) = prop_static : "Static GLTF model"
[
    
    model(string) : "Model path (relative to resources/models)"
    angle(integer) : "Yaw" : 0
    scale(float) : "Uniform scale" : "1"
    triggerid(integer) : "Trigger Reciever ID" : -1
]
@PointClass size(-16 -16 -16, 16 16 16) color(100 180 255) model({ "path": "resources/models/" + model, "scale": scale * 20 }) = prop_dynamic : "Dynamic GLTF model"
[
    model(string) : "Model path (relative to resources/models)"
    angle(integer) : "Yaw" : 0
    scale(float) : "Uniform scale" : "1"
    triggerid(integer) : "Trigger Reciever ID" : -1
]
@BaseClass size(-16 -16 -16, 16 16 16) model({"path": "resources/models/" + model, "scale": scale * 20}) = wallbuy [
    model(string) : "ModelPath (relative to resources/models)"
    angle(integer) : "Yaw" : 0
    cost(integer) : "Cost" : 0
    purchased(integer) : "0:1 Been Bought" : 0

]

// 2. Define the unique variations, each with their own flat viewport color
@PointClass base(wallbuy)  = weapon_1911 : "Standard Type (Green Flat Color)" []
@PointClass base(wallbuy)  = weapon_ak47 : "Hazardous Type (Red Flat Color)" []
@PointClass base(wallbuy)  = weapon_remmington : "Secret Type (Blue Flat Color)" []

