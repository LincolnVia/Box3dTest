@SolidClass = worldspawn : "Box3dTest world"
[
    message(string) : "Level name"
]

@PointClass size(-16 -16 -24, 16 16 32) color(0 255 0) = info_player_start : "Player start"
[
    angle(integer) : "Direction" : 0
]

@PointClass size(-16 -16 -24, 16 16 32) color(0 200 0) = info_player_deathmatch : "Alternate player start"
[
    angle(integer) : "Direction" : 0
]

@PointClass size(-8 -8 -8, 8 8 8) color(255 255 100) = light : "Point light"
[
    light(integer) : "Brightness" : 300
    _color(color255) : "Color" : "255 255 255"
]
