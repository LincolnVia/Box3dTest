@SolidClass = worldspawn : "Box3dTest world"
[
    message(string) : "Level name"
]

@PointClass size(-16 -16 -24, 16 16 32) color(0 255 0) = info_player_start : "Player start"
[
    angle(integer) : "Direction" : 0
]

@PointClass size(-16 -16 -24, 16 16 32) color(0 200 0) = info_player_deathmatch : "Alternate player start"
[
    angle(integer) : "Direction" : 0
]

@PointClass size(-8 -8 -8, 8 8 8) color(255 255 100) = light : "Point light"
[
    light(integer) : "Brightness" : 300
    _color(color255) : "Color" : "255 255 255"
]
@PointClass size(-8 -8 -8, 8 8 8) color(255 255 100) = info_trigger : "Trigger"
[
    target(integer) : "target" : -1
    triggered(integer) : "Triggered" : 0
    enabled(integer) : "Enabled" : 1
]

@PointClass size(-8 -8 -8, 8 8 8) color(255 0 0) = info_enemy_spawn : "Enemy spawner"
[
    spawnrate(integer) : "Spawn Rate" : 0
    limit(integer) : "Max Spawns" : 1 
    enabled(integer) : "Enabled" : 1
]
@PointClass size(-16 -16 0, 16 16 32) color(100 180 255) = prop_static : "Static GLTF model"

    model(string) : "Model path (relative to resources/models)"
    angle(integer) : "Yaw" : 0
    scale(float) : "Uniform scale" : "1"
    triggerid(integer) : "Trigger Reciever ID" : -1
]
